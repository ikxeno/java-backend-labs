<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
  <!--
    Application output streams belong to the caller and are intentionally
    shared.
  -->
  <Match>
    <Class
      name="~io\.github\.ikxeno\.(application\.LabApplication|demo\.CrudDemo)"/>
    <Field name="~(output|error)"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
  <!--
    Repository instances are shared services, not defensive-copy value objects.
  -->
  <Match>
    <Class
      name="~io\.github\.ikxeno\.(service\.LocationService|demo\.CrudDemo)"/>
    <Field name="characterRepository"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
  <!--
    Injected collaborators are shared services, not defensive-copy value
    objects.
  -->
  <Match>
    <Or>
      <Class name="io.github.ikxeno.demo.AirplaneCrudDemo"/>
      <Class name="io.github.ikxeno.service.DefaultAirplaneService"/>
      <Class name="io.github.ikxeno.controller.AirplaneController"/>
    </Or>
    <Field name="~(repository|service)"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
  <!--
    Spring AOT resolves required constructor dependencies before invoking
    generated suppliers.
  -->
  <Match>
    <Class name="~.*__BeanDefinitions"/>
    <Bug pattern="NP_NULL_ON_SOME_PATH_FROM_RETURN_VALUE"/>
  </Match>
</FindBugsFilter>

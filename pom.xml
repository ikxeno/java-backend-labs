<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.ikxeno</groupId>
    <artifactId>java-backend-labs</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Java Backend Labs</name>
    <description>Java backend course assignments, variant 15</description>

    <modules>
        <module>lab-1</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <maven.compiler.release>25</maven.compiler.release>
        <commons-csv.version>1.14.1</commons-csv.version>
        <jcommander.version>3.0</jcommander.version>
        <junit.version>6.1.3</junit.version>
        <maven-compiler-plugin.version>3.16.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.6.0</maven-surefire-plugin.version>
        <maven-resources-plugin.version>3.5.0</maven-resources-plugin.version>
        <maven-jar-plugin.version>3.5.1</maven-jar-plugin.version>
        <maven-antrun-plugin.version>3.2.0</maven-antrun-plugin.version>
        <maven-clean-plugin.version>3.5.0</maven-clean-plugin.version>
        <spotbugs-maven-plugin.version>4.10.5.0</spotbugs-maven-plugin.version>
        <mvn-jlink-wrapper.version>1.2.6</mvn-jlink-wrapper.version>
        <maven.compiler.fork>true</maven.compiler.fork>
        <maven.compiler.executable>${graalvm.home}/bin/${graalvm.javac}</maven.compiler.executable>
        <graalvm.java>java</graalvm.java>
        <graalvm.javac>javac</graalvm.javac>
        <graalvm.version>25.0.4</graalvm.version>
        <graalvm.cache.directory>${user.home}/.mvnJlinkCache</graalvm.cache.directory>
        <graalvm.cache.id>graalvm-${graalvm.version}-${graalvm.os}-${graalvm.arch}</graalvm.cache.id>
        <graalvm.home>${graalvm.cache.directory}/${graalvm.cache.id}</graalvm.home>
        <graalvm.os>linux</graalvm.os>
        <graalvm.arch>x64</graalvm.arch>
        <graalvm.archive>tar.gz</graalvm.archive>
        <graalvm.download.url>https://download.oracle.com/graalvm/25/archive/graalvm-jdk-${graalvm.version}_${graalvm.os}-${graalvm.arch}_bin.${graalvm.archive}</graalvm.download.url>
        <graalvm.native-image.tool>../lib/svm/bin/native-image</graalvm.native-image.tool>
        <maven-shade-plugin.version>3.6.2</maven-shade-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.jcommander</groupId>
                <artifactId>jcommander</artifactId>
                <version>${jcommander.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-csv</artifactId>
                <version>${commons-csv.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <version>${spotbugs-maven-plugin.version}</version>
                <configuration>
                    <effort>Max</effort>
                    <threshold>Low</threshold>
                    <failOnError>true</failOnError>
                    <excludeFilterFile>${maven.multiModuleProjectDirectory}/config/spotbugs-exclude.xml</excludeFilterFile>
                </configuration>
                <executions>
                    <execution>
                        <id>spotbugs-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>com.igormaznitsa</groupId>
                    <artifactId>mvn-jlink-wrapper</artifactId>
                    <version>${mvn-jlink-wrapper.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-clean-plugin</artifactId>
                    <version>${maven-clean-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-antrun-plugin</artifactId>
                    <version>${maven-antrun-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                    <configuration>
                        <jvm>${graalvm.home}/bin/${graalvm.java}</jvm>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>${maven-resources-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>${maven-jar-plugin.version}</version>
                    <configuration>
                        <forceCreation>true</forceCreation>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-shade-plugin</artifactId>
                    <version>${maven-shade-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
    <profiles>
        <profile>
            <id>graalvm-alpine</id>
            <activation><file><exists>/etc/alpine-release</exists></file></activation>
            <properties>
                <liberica-nik.version>25.0.4.1</liberica-nik.version>
                <graalvm.cache.id>liberica-nik-${liberica-nik.version}-alpine-${graalvm.arch}</graalvm.cache.id>
                <graalvm.download.url>https://download.bell-sw.com/vm/${liberica-nik.version}/bellsoft-liberica-vm-openjdk${liberica-nik.version}%2B2-${liberica-nik.version}%2B1-linux-${graalvm.arch}-musl.tar.gz</graalvm.download.url>
            </properties>
        </profile>
        <profile>
            <id>graalvm-macos</id>
            <activation><os><family>mac</family></os></activation>
            <properties>
                <graalvm.os>macos</graalvm.os>
                <graalvm.native-image.tool>../lib/svm/bin/native-image</graalvm.native-image.tool>
            </properties>
        </profile>
        <profile>
            <id>graalvm-windows</id>
            <activation><os><family>windows</family></os></activation>
            <properties>
                <graalvm.os>windows</graalvm.os>
                <graalvm.archive>zip</graalvm.archive>
                <graalvm.native-image.tool>native-image.cmd</graalvm.native-image.tool>
                <graalvm.java>java.exe</graalvm.java>
                <graalvm.javac>javac.exe</graalvm.javac>
            </properties>
        </profile>
        <profile>
            <id>graalvm-aarch64</id>
            <activation><os><arch>aarch64</arch></os></activation>
            <properties><graalvm.arch>aarch64</graalvm.arch></properties>
        </profile>
        <profile>
            <id>graalvm-arm64</id>
            <activation><os><arch>arm64</arch></os></activation>
            <properties><graalvm.arch>aarch64</graalvm.arch></properties>
        </profile>
    </profiles>
</project>
